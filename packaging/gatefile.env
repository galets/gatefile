# Gatefile defaults. REQUIRED: set API_KEY. Installed as conffile.
# DOCUMENT_PATH must be writable by the gatefile user.
BASE_URL=/gatefile/file
DOCUMENT_PATH=/var/lib/gatefile/file.txt
API_KEY=change-me
ADDR=127.0.0.1:8654
# GATEFILE_HOOK=
# Poll interval for external change detection in ms (0 disables).
GATEFILE_POLL_MS=1000
# Stable ticks before a polled change is committed.
GATEFILE_POLL_SETTLE_TICKS=2
